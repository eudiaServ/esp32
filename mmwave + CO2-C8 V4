# Włączenie natywnego protokołu ESP-NOW w ESPHome
espnow:
  enable_on_boot: true

uart:
  - id: uart_ld2410
    tx_pin: GPIO17
    rx_pin: GPIO16
    baud_rate: 256000

  - id: uart_co2
    tx_pin: GPIO19
    rx_pin:
      number: GPIO18
      mode:
        input: true
        pullup: true
    baud_rate: 9600
    debug:
      direction: RX
      dummy_receiver: true
      after:
        timeout: 50ms
      sequence:
        - lambda: |-
            if (bytes.size() >= 10 && bytes[0] == 0x42 && bytes[1] == 0x4D) {
              uint16_t co2 = (uint16_t(bytes[6]) << 8) | bytes[7];
              if (co2 >= 350 && co2 <= 10000) {
                id(poziom_co2).publish_state(co2);
              }
            }
ld2410:
  id: ld2410_component
  uart_id: uart_ld2410

binary_sensor:
  - platform: ld2410
    ld2410_id: ld2410_component
    has_target:
      name: "Obecnosc w pokoju"
      id: pokoj_obecnosc
      on_press:
        then:
          - lambda: |-
              uint8_t data = 1;
              uint8_t target_mac[6] = {0x40, 0x22, 0xD8, 0x15, 0xC6, 0x84};
              espnow::global_esp_now->send(target_mac, &data, 1);
      on_release:
        then:
          - lambda: |-
              uint8_t data = 0;
              uint8_t target_mac[6] = {0x40, 0x22, 0xD8, 0x15, 0xC6, 0x84};
              espnow::global_esp_now->send(target_mac, &data, 1);
    has_moving_target:
      name: "Wykryto ruch"
    has_still_target:
      name: "Wykryto obiekt statyczny"

sensor:
  - platform: template
    name: "Poziom CO2"
    id: poziom_co2
    unit_of_measurement: "ppm"
    device_class: "carbon_dioxide"
    state_class: "measurement"
    accuracy_decimals: 0
    icon: "mdi:molecule-co2"
    update_interval: never
    filters:
      - throttle_average: 15s

  - platform: ld2410
    ld2410_id: ld2410_component
    moving_distance:
      name: "Aktualna odległość ruchu"
      id: pokoj_moving_distance
    still_distance:
      name: "Aktualna odległość obiektu statycznego"
      id: pokoj_still_distance
    moving_energy:
      name: "Energia ruchu"
    still_energy:
      name: "Energia obiektu statycznego"
    detection_distance:
      name: "Całkowita odległość wykrywania"
    g0:
      move_energy:
